# Copy this file to `.env` and fill in the values.

# SUPABASE (Dashboard > Project Settings > API Keys)
SUPABASE_SECRET_KEY="sb_secret_xxx"
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Connect to Postgres via the shared session-mode pooler (session-capable, required by Prisma Next).
# Copy it from Dashboard > Connect > Session pooler; the host (aws-0/aws-1, region) must match your project.
# Requires PostgreSQL >= 15.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# HOLODEX (https://holodex.net > Account settings > API key)
HOLODEX_API_URL=https://holodex.net/api/v2
HOLODEX_API_KEY=""

# YOUTUBE Data API v3 key (Google Cloud Console > APIs & Services > Credentials)
YOUTUBE_API_DATA_API=""
YOUTUBE_API_URL=https://www.googleapis.com/youtube/v3

# CRON: shared secret for /api/cron/sync-channels; must match the Vault secret in supabase/cron/sync-channels.sql.
CRON_SECRET="your_cron_secret_key"
